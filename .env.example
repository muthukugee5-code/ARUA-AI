# AURA AI - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================
# FLASK CONFIGURATION
# ============================================================
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
PORT=5000

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ============================================================
# SUPABASE CONFIGURATION
# Get these from: https://supabase.com → Project Settings → API
# ============================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ============================================================
# HUGGING FACE API (Free Tier)
# Get your key from: https://huggingface.co/settings/tokens
# Used for: Prompt enhancement (Mixtral-8x7B)
# Free tier: ~30K tokens/month
# ============================================================
HUGGINGFACE_API_KEY=hf_your_api_key_here

# ============================================================
# POLLINATIONS.AI (Free - No API key required)
# Image generation via: https://image.pollinations.ai
# No key needed - completely free and unlimited
# ============================================================
# POLLINATIONS_BASE=https://image.pollinations.ai/prompt

# ============================================================
# STORAGE CONFIGURATION
# Upload folder for temporary files
# ============================================================
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_GENERATE=30
RATE_LIMIT_ENHANCE=20
RATE_LIMIT_AUTH=10

# ============================================================
# GOOGLE GEMINI API (for Smart Agent Mode)
# Get your key from: https://aistudio.google.com/apikey
# Used for: Agent smart mode text generation (Gemini 2.0 Flash)
# ============================================================
GEMINI_API_KEY=

# ============================================================
# IBM WATSON CONFIGURATION (Optional - Mock mode by default)
# Used for: NLP prompt analysis, Assistant chatbot, Visual Recognition
# Set WATSON_MODE=live if you have IBM Cloud credentials
# ============================================================
WATSON_MODE=mock
WATSON_API_KEY=
WATSON_URL=
WATSON_ASSISTANT_ID=
WATSON_PROJECT_ID=
